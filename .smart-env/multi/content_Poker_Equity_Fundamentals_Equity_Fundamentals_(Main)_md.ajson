ty Buckets#Key Takeaways#{8}":[551,552],"#Article 2 — The Magic of Equity Buckets#Key Takeaways#{9}":[553,554],"#Article 2 — The Magic of Equity Buckets#Related Documents":[555,567],"#Article 2 — The Magic of Equity Buckets#Related Documents#{1}":[557,558],"#Article 2 — The Magic of Equity Buckets#Related Documents#{2}":[559,560],"#Article 2 — The Magic of Equity Buckets#Related Documents#Sources":[561,567],"#Article 2 — The Magic of Equity Buckets#Related Documents#Sources#{1}":[563,567]},"outlinks":[{"title":"What is Equity in Poker?","target":"https://blog.gtowizard.com/what-is-equity-in-poker/","line":7},{"title":"The Magic of Equity Buckets","target":"https://blog.gtowizard.com/the-magic-of-equity-buckets/","line":8},{"title":"Equity at a glance — what the % number means.","target":"eq1_fig01_fig1.png","line":28,"embedded":true},{"title":"Hand-vs-hand equity calculator: AA dominates 65s but 65s still has ~23% from runner-runner equity.","target":"eq1_fig03_fig3.png","line":70,"embedded":true},{"title":"EV of 72o vs a BTN open: passes the pot-odds test but loses 0.48 bb/hand — equity under-realization in action.","target":"eq1_fig02_ev_of_72o_vs_btn_open.png","line":107,"embedded":true},{"title":"Equity realization: the bridge between raw check-down equity and actual EV.","target":"eq1_fig05_fig5.png","line":116,"embedded":true},{"title":"EQR formula visualized — pot share divided by raw equity.","target":"eq1_fig06_fig6.png","line":129,"embedded":true},{"title":"6♥3♥ on J♠8♥5♥ — same ~43% raw equity, but EQR > 90% because of flush + gutshot continuation value.","target":"eq1_fig08_fig8.png","line":163,"embedded":true},{"title":"A♠9♠ on J♠8♥5♥ — 43.3% raw equity, only 13.5% pot share (EQR ~31%).","target":"eq1_fig04_fig4.png","line":167,"embedded":true},{"title":"Range-vs-range distribution view: equity buckets on the left, equity graph on the right.","target":"eq1_fig07_fig7.png","line":176,"embedded":true},{"title":"BB vs BTN on J♠8♥5♥ — bucket view of the distribution.","target":"eq1_fig09_fig9.png","line":192,"embedded":true},{"title":"J♠8♥5♥ buckets: BTN holds 2× the best hands, ⅓ the worst.","target":"eq1_fig10_fig10.png","line":210,"embedded":true},{"title":"BTN A5s sits at the (62%, 57%) coordinate on the equity graph — better than 62% of BTN's range, 57% equity vs BB.","target":"eq1_fig11_fig11.png","line":228,"embedded":true},{"title":"River runout K♥J♦5♦ 2♣ Q♥ — BTN polarized, BB condensed.","target":"eq1_fig12_fig12.png","line":258,"embedded":true},{"title":"BTN's nut advantage on the Q♥ river: equity is 50/50 but the shape is wildly asymmetric.","target":"eq1_fig13_fig13.png","line":261,"embedded":true},{"title":"Q♥J♥8♣ A♥ board — BTN has a middling 52% range advantage, no nut advantage. Small to medium sizings only.","target":"eq1_fig14_btn_vs_bb_equity_distribution.png","line":276,"embedded":true},{"title":"Solver matrix overload — every cell, every bet sizing, every action mix.","target":"eq2_fig01_fig1.png","line":305,"embedded":true},{"title":"The same matrix simplified through abstraction.","target":"eq2_fig02_fig2.png","line":308,"embedded":true},{"title":"Equity matrices — raw cell-by-cell view.","target":"eq2_fig03_equity_matrices.png","line":357,"embedded":true},{"title":"Simple equity buckets: Best / Good / Weak / Trash.","target":"eq2_fig04_equity_buckets.png","line":360,"embedded":true},{"title":"Bucket view abstracts the matrix into four meaningful chunks.","target":"eq2_fig05_equity_buckets.png","line":363,"embedded":true},{"title":"K♦Q♣2♠ — raw equity matrix for UTG vs BB.","target":"eq2_fig06_equity_matrices.png","line":392,"embedded":true},{"title":"K♦Q♣2♠ bucket view: UTG dominates Best/Good/Weak; BB has 57.6% Trash.","target":"eq2_fig08_equity_buckets.png","line":395,"embedded":true},{"title":"A♠8♦2♣ A♣ 7♥ river — UTG range polarized, BTN range condensed.","target":"eq2_fig07_equity_matrices.png","line":408,"embedded":true},{"title":"K♦5♠5♣ — Top advanced (90–100%) bucket highlighted: BB holds 6.8% here vs UTG's 2.9%, the reason UTG bets small.","target":"eq2_fig09_top_advanced_90_100_eq_bucket_highlighted.png","line":421,"embedded":true},{"title":"A♣Q♦8♥ flop — BB's hand-matrix strategy facing UTG's 33% c-bet.","target":"eq2_fig10_hand_matrix_strategy.png","line":436,"embedded":true},{"title":"Same spot — broken into bet sizing mix.","target":"eq2_fig11_fig11.png","line":439,"embedded":true},{"title":"A♣Q♦8♥ flop — same strategy bucketed: mostly fold, ~⅓ call, ~10% check-raise.","target":"eq2_fig12_eq_buckets_strategy.png","line":442,"embedded":true},{"title":"BB's **Best** hands on A♣Q♦8♥ — AK, sets, two-pair check-raise for value.","target":"eq2_fig13_bb_s_best_hands_strategy_when_utg_c_bets_33_pot.png","line":445,"embedded":true},{"title":"BB's **Good** hands — ATs and similar call as bluff-catchers (raising loses value).","target":"eq2_fig14_bb_s_good_hands_strategy_when_utg_c_bets_33_pot.png","line":448,"embedded":true},{"title":"BB's **Weak** hands — gutshots like JT and bottom-pair merges become the FLOP bluff candidates because they retain improvability.","target":"eq2_fig15_bb_s_weak_hands_strategy_when_utg_c_bets_33_pot.png","line":451,"embedded":true},{"title":"River 7♦ — BB probes nearly half the time. Hand-matrix view.","target":"eq2_fig16_hand_matrix_bb_s_river_probe_strategy.png","line":454,"embedded":true},{"title":"River 7♦ — sizing distribution for the probe.","target":"eq2_fig17_fig17.png","line":457,"embedded":true},{"title":"River 7♦ — bucket view of the probe strategy.","target":"eq2_fig18_eq_buckets_bb_s_river_probe_strategy.png","line":460,"embedded":true},{"title":"Good and Weak hands now check as bluff-catchers (the flop bluff candidates).","target":"eq2_fig19_bb_s_good_and_weak_hands_river_strategy.png","line":463,"embedded":true},{"title":"River bluffs come from the **0–25% advanced bucket** — Trash, not Weak.","target":"eq2_fig20_bb_s_bottom_advanced_0_25_eq_bucket_river_strategy.png","line":466,"embedded":true},{"title":"Level 1 — overall shape of the range (linear, capped, polarized).","target":"eq2_fig22_overall_shape_of_range.png","line":479,"embedded":true},{"title":"Level 2 — the same range broken down into equity buckets.","target":"eq2_fig23_range_broken_down_in_eq_buckets.png","line":482,"embedded":true},{"title":"Level 3 — buckets filled with hand classes (pairs, draws, etc.).","target":"eq2_fig24_eq_buckets_filled_with_hand_classes.png","line":485,"embedded":true},{"title":"Level 4 — hand classes drilled down to specific hands.","target":"eq2_fig25_hand_classes_consist_of_hands.png","line":488,"embedded":true},{"title":"Base level — hands drilled to all suit-specific combinations.","target":"eq2_fig26_hands_drilled_down_to_all_the_suit_specific_combin.png","line":491,"embedded":true},{"title":"Chunking + equity buckets — the through-line of the whole article.","target":"eq2_fig27_fig27.png","line":526,"embedded":true},{"title":"GTO Wizard's equity-bucket selector — the software interface.","target":"eq2_fig21_fig21.png","line":529,"embedded":true},{"title":"The Course (Main)","target":"<../The Course/The Course (Main","line":557},{"title":"What is Equity in Poker?","target":"https://blog.gtowizard.com/what-is-equity-in-poker/","line":565},{"title":"The Magic of Equity Buckets","target":"https://blog.gtowizard.com/the-magic-of-equity-buckets/","line":566}],"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"content/Poker/Equity Fundamentals/Equity Fundamentals (Main).md"},"smart_blocks:content/Poker/Equity Fundamentals/Equity Fundamentals (Main).md#Article 1 — What is Equity in Poker?": {"path":null,"last_embed":{"hash":"cpjh96","at":1780981905490},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.01853784,-0.04509702,-0.06118977,0.01271422,-0.03049612,0.08685916,0.08996992,0.01374703,0.08816822,0.03666726,-0.03597451,-0.03598801,0.01967075,0.02542298,-0.01882125,0.00564152,-0.00972009,0.01419875,-0.07331213,0.04249151,0.05715642,-0.05550674,-0.01293997,-0.05700964,0.08