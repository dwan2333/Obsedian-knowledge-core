ic of Equity Buckets#2. Chunking#{1}":[336,355],"#Article 2 — The Magic of Equity Buckets#2. Chunking#{2}":[356,356],"#Article 2 — The Magic of Equity Buckets#2. Chunking#{3}":[357,357],"#Article 2 — The Magic of Equity Buckets#2. Chunking#{4}":[358,359],"#Article 2 — The Magic of Equity Buckets#2. Chunking#{5}":[360,365],"#Article 2 — The Magic of Equity Buckets#3. Equity Buckets":[366,483],"#Article 2 — The Magic of Equity Buckets#3. Equity Buckets#{1}":[369,394],"#Article 2 — The Magic of Equity Buckets#3. Equity Buckets#Example 1: K♦Q♣2♠ — range-check vs range-bet":[395,410],"#Article 2 — The Magic of Equity Buckets#3. Equity Buckets#Example 1: K♦Q♣2♠ — range-check vs range-bet#{1}":[397,410],"#Article 2 — The Magic of Equity Buckets#3. Equity Buckets#Example 2: A♠8♦2♣ → A♣ → 7♥ — polarized vs condensed":[411,423],"#Article 2 — The Magic of Equity Buckets#3. Equity Buckets#Example 2: A♠8♦2♣ → A♣ → 7♥ — polarized vs condensed#{1}":[413,423],"#Article 2 — The Magic of Equity Buckets#3. Equity Buckets#Example 3: K♦5♠5♣ — nut advantage drives sizing":[424,436],"#Article 2 — The Magic of Equity Buckets#3. Equity Buckets#Example 3: K♦5♠5♣ — nut advantage drives sizing#{1}":[426,436],"#Article 2 — The Magic of Equity Buckets#3. Equity Buckets#Example 4: A♣Q♦8♥ → 2♠ → 7♦ — flop and river bluff selection":[437,483],"#Article 2 — The Magic of Equity Buckets#3. Equity Buckets#Example 4: A♣Q♦8♥ → 2♠ → 7♦ — flop and river bluff selection#{1}":[439,483],"#Article 2 — The Magic of Equity Buckets#4. Working Memory in Poker":[484,534],"#Article 2 — The Magic of Equity Buckets#4. Working Memory in Poker#{1}":[486,534],"#Article 2 — The Magic of Equity Buckets#5. Conclusion":[535,553],"#Article 2 — The Magic of Equity Buckets#5. Conclusion#{1}":[538,553],"#Article 2 — The Magic of Equity Buckets#Key Takeaways":[554,566],"#Article 2 — The Magic of Equity Buckets#Key Takeaways#{1}":[556,556],"#Article 2 — The Magic of Equity Buckets#Key Takeaways#{2}":[557,557],"#Article 2 — The Magic of Equity Buckets#Key Takeaways#{3}":[558,558],"#Article 2 — The Magic of Equity Buckets#Key Takeaways#{4}":[559,559],"#Article 2 — The Magic of Equity Buckets#Key Takeaways#{5}":[560,560],"#Article 2 — The Magic of Equity Buckets#Key Takeaways#{6}":[561,561],"#Article 2 — The Magic of Equity Buckets#Key Takeaways#{7}":[562,562],"#Article 2 — The Magic of Equity Buckets#Key Takeaways#{8}":[563,564],"#Article 2 — The Magic of Equity Buckets#Key Takeaways#{9}":[565,566],"#Article 2 — The Magic of Equity Buckets#Related Documents":[567,579],"#Article 2 — The Magic of Equity Buckets#Related Documents#{1}":[569,570],"#Article 2 — The Magic of Equity Buckets#Related Documents#{2}":[571,572],"#Article 2 — The Magic of Equity Buckets#Related Documents#Sources":[573,579],"#Article 2 — The Magic of Equity Buckets#Related Documents#Sources#{1}":[575,579]},"outlinks":[{"title":"What is Equity in Poker?","target":"https://blog.gtowizard.com/what-is-equity-in-poker/","line":7},{"title":"The Magic of Equity Buckets","target":"https://blog.gtowizard.com/the-magic-of-equity-buckets/","line":8},{"title":"Equity at a glance — what the % number means.","target":"eq1_fig01_fig1.png","line":28,"embedded":true},{"title":"Hand-vs-hand equity calculator: AA dominates 65s but 65s still has ~23% from runner-runner equity.","target":"eq1_fig03_fig3.png","line":70,"embedded":true},{"title":"EV of 72o vs a BTN open: passes the pot-odds test but loses 0.48 bb/hand — equity under-realization in action.","target":"eq1_fig02_ev_of_72o_vs_btn_open.png","line":119,"embedded":true},{"title":"Equity realization: the bridge between raw check-down equity and actual EV.","target":"eq1_fig05_fig5.png","line":128,"embedded":true},{"title":"EQR formula visualized — pot share divided by raw equity.","target":"eq1_fig06_fig6.png","line":141,"embedded":true},{"title":"6♥3♥ on J♠8♥5♥ — same ~43% raw equity, but EQR > 90% because of flush + gutshot continuation value.","target":"eq1_fig08_fig8.png","line":175,"embedded":true},{"title":"A♠9♠ on J♠8♥5♥ — 43.3% raw equity, only 13.5% pot share (EQR ~31%).","target":"eq1_fig04_fig4.png","line":179,"embedded":true},{"title":"Range-vs-range distribution view: equity buckets on the left, equity graph on the right.","target":"eq1_fig07_fig7.png","line":188,"embedded":true},{"title":"BB vs BTN on J♠8♥5♥ — bucket view of the distribution.","target":"eq1_fig09_fig9.png","line":204,"embedded":true},{"title":"J♠8♥5♥ buckets: BTN holds 2× the best hands, ⅓ the worst.","target":"eq1_fig10_fig10.png","line":222,"embedded":true},{"title":"BTN A5s sits at the (62%, 57%) coordinate on the equity graph — better than 62% of BTN's range, 57% equity vs BB.","target":"eq1_fig11_fig11.png","line":240,"embedded":true},{"title":"River runout K♥J♦5♦ 2♣ Q♥ — BTN polarized, BB condensed.","target":"eq1_fig12_fig12.png","line":270,"embedded":true},{"title":"BTN's nut advantage on the Q♥ river: equity is 50/50 but the shape is wildly asymmetric.","target":"eq1_fig13_fig13.png","line":273,"embedded":true},{"title":"Q♥J♥8♣ A♥ board — BTN has a middling 52% range advantage, no nut advantage. Small to medium sizings only.","target":"eq1_fig14_btn_vs_bb_equity_distribution.png","line":288,"embedded":true},{"title":"Solver matrix overload — every cell, every bet sizing, every action mix.","target":"eq2_fig01_fig1.png","line":317,"embedded":true},{"title":"The same matrix simplified through abstraction.","target":"eq2_fig02_fig2.png","line":320,"embedded":true},{"title":"Equity matrices — raw cell-by-cell view.","target":"eq2_fig03_equity_matrices.png","line":369,"embedded":true},{"title":"Simple equity buckets: Best / Good / Weak / Trash.","target":"eq2_fig04_equity_buckets.png","line":372,"embedded":true},{"title":"Bucket view abstracts the matrix into four meaningful chunks.","target":"eq2_fig05_equity_buckets.png","line":375,"embedded":true},{"title":"K♦Q♣2♠ — raw equity matrix for UTG vs BB.","target":"eq2_fig06_equity_matrices.png","line":404,"embedded":true},{"title":"K♦Q♣2♠ bucket view: UTG dominates Best/Good/Weak; BB has 57.6% Trash.","target":"eq2_fig08_equity_buckets.png","line":407,"embedded":true},{"title":"A♠8♦2♣ A♣ 7♥ river — UTG range polarized, BTN range condensed.","target":"eq2_fig07_equity_matrices.png","line":420,"embedded":true},{"title":"K♦5♠5♣ — Top advanced (90–100%) bucket highlighted: BB holds 6.8% here vs UTG's 2.9%, the reason UTG bets small.","target":"eq2_fig09_top_advanced_90_100_eq_bucket_highlighted.png","line":433,"embedded":true},{"title":"A♣Q♦8♥ flop — BB's hand-matrix strategy facing UTG's 33% c-bet.","target":"eq2_fig10_hand_matrix_strategy.png","line":448,"embedded":true},{"title":"Same spot — broken into bet sizing mix.","target":"eq2_fig11_fig11.png","line":451,"embedded":true},{"title":"A♣Q♦8♥ flop — same strategy bucketed: mostly fold, ~⅓ call, ~10% check-raise.","target":"eq2_fig12_eq_buckets_strategy.png","line":454,"embedded":true},{"title":"BB's **Best** hands on A♣Q♦8♥ — AK, sets, two-pair check-raise for value.","target":"eq2_fig13_bb_s_best_hands_strategy_when_utg_c_bets_33_pot.png","line":457,"embedded":true},{"title":"BB's **Good** hands — ATs and similar call as bluff-catchers (raising loses value).","target":"eq2_fig14_bb_s_good_hands_strategy_when_utg_c_bets_33_pot.png","line":460,"embedded":true},{"title":"BB's **Weak** hands — gutshots like JT and bottom-pair merges become the FLOP bluff candidates because they retain improvability.","target":"eq2_fig15_bb_s_weak_hands_strategy_when_utg_c_bets_33_pot.png","line":463,"embedded":true},{"title":"River 7♦ — BB probes nearly half the time. Hand-matrix view.","target":"eq2_fig16_hand_matrix_bb_s_river_probe_strategy.png","line":466,"embedded":true},{"title":"River 7♦ — sizing distribution for the probe.","target":"eq2_fig17_fig17.png","line":469,"embedded":true},{"title":"River 7♦ — bucket view of the probe strategy.","target":"eq2_fig18_eq_buckets_bb_s_river_probe_strategy.png","line":472,"embedded":true},{"title":"Good and Weak hands now check as bluff-catchers (the flop bluff candidates).","target":"eq2_fig19_bb_s_good_and_weak_hands_river_strategy.png","line":475,"embedded":true},{"title":"River bluffs come from the **0–25% advanced bucket** — Trash, not Weak.","target":"eq2_fig20_bb_s_bottom_advanced_0_25_eq_bucket_river_strategy.png","line":478,"embedded":true},{"title":"Level 1 — overall shape of the range (linear, capped, polarized).","target":"eq2_fig22_overall_shape_of_range.png","line":491,"embedded":true},{"title":"Level 2 — the same range broken down into equity buckets.","target":"eq2_fig23_range_broken_down_in_eq_buckets.png","line":494,"embedded":true},{"title":"Level 3 — buckets filled with hand classes (pairs, draws, etc.).","target":"eq2_fig24_eq_buckets_filled_with_hand_classes.png","line":497,"embedded":true},{"title":"Level 4 — hand classes drilled down to specific hands.","target":"eq2_fig25_hand_classes_consist_of_hands.png","line":500,"embedded":true},{"title":"Base level — hands drilled to all suit-specific combinations.","target":"eq2_fig26_hands_drilled_down_to_all_the_suit_specific_combin.png","line":503,"embedded":true},{"title":"Chunking + equity buckets — the through-line of the whole article.","target":"eq2_fig27_fig27.png","line":538,"embedded":true},{"title":"GTO Wizard's equity-bucket selector — the software interface.","target":"eq2_fig21_fig21.png","line":541,"embedded":true},{"title":"The Course (Main)","target":"<../The Course/The Course (Main","line":569},{"title":"What is Equity in Poker?","target":"https://blog.gtowizard.com/what-is-equity-in-poker/","line":577},{"title":"The Magic of Equity Buckets","target":"https://blog.gtowizard.com/the-magic-of-equity-buckets/","line":578}],"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"content/Poker/Equity Fundamentals/Equity Fundamentals (Main).md"},"smart_blocks:content/Poker/Equity Fundamentals/Equity Fundamentals (Main).md#Article 1 — What is Equity in Poker?": {"path":null,"last_embed