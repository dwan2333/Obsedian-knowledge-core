:true},{"title":"River runout K♥J♦5♦ 2♣ Q♥ — BTN polarized, BB condensed.","target":"eq1_fig12_fig12.png","line":242,"embedded":true},{"title":"BTN's nut advantage on the Q♥ river: equity is 50/50 but the shape is wildly asymmetric.","target":"eq1_fig13_fig13.png","line":245,"embedded":true},{"title":"Q♥J♥8♣ A♥ board — BTN has a middling 52% range advantage, no nut advantage. Small to medium sizings only.","target":"eq1_fig14_btn_vs_bb_equity_distribution.png","line":260,"embedded":true}],"class_name":"SmartBlock"},
